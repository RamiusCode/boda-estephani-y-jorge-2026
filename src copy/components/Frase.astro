---
// src/components/Frase.astro
// Banda vino con la frase de apertura.
// ── DATO EDITABLE ─────────────────────────────────────────────
const frase = ["A VECES LO QUE EMPIEZA COMO UNA LOCURA", "SE CONVIERTE EN LO MEJOR DE TU VIDA"];
// ──────────────────────────────────────────────────────────────
---

<section class="w-full bg-vino py-9 px-4 mt-4">
    <p
        class="frase-texto font-callingstone text-crema text-center text-[clamp(0.6rem,3.05vw,0.83rem)] tracking-[0.06em] leading-[2]"
    >
        {frase.map((linea) => <span class="block whitespace-nowrap">{linea}</span>)}
    </p>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        gsap.utils.toArray<HTMLElement>(".frase-texto span").forEach((linea, i) => {
            gsap.from(linea, {
                scrollTrigger: { trigger: linea, start: "top 90%" },
                opacity: 0,
                y: 16,
                duration: 0.8,
                delay: i * 0.12,
                ease: "power2.out",
            });
        });
    });
</script>
