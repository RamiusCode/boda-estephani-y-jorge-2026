---
// src/components/CodigoVestimenta.astro
// Banda "Código de vestimenta" + etiqueta formal y nota del color blanco.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "CÓDIGO DE VESTIMENTA";
const etiqueta = "FORMAL";
// ──────────────────────────────────────────────────────────────
---

<section class="w-full bg-vino py-8 px-7">
    <h2
        class="font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="vestimenta" class="w-full px-7 pt-14 pb-24 text-center">
    <span
        class="icono icono-marron w-[105px] h-[105px] mx-auto"
        style="--ic: url('/imagenes/vestimenta.png')"
        aria-hidden="true"></span>

    <h3
        class="font-callingstone text-vino text-[clamp(0.7rem,3.55vw,0.96rem)] tracking-[0.14em] mt-5"
    >
        {etiqueta}
    </h3>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("vestimenta");
        if (!seccion) return;

        gsap.from(seccion.children, {
            scrollTrigger: { trigger: seccion, start: "top 86%" },
            opacity: 0,
            y: 24,
            duration: 0.9,
            stagger: 0.15,
            ease: "power2.out",
        });
    });
</script>
