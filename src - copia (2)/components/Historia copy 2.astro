---
// src/components/Historia.astro
// Banda "Nuestra Historia" + la historia completa dentro de un arco vino.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "NUESTRA HISTORIA";
const tituloArco = "Historia";

const parrafos = [
    "Hay historias que comienzan en el momento menos esperado… y otras que, sin saberlo, empiezan mucho antes.",
    "La nuestra comenzó hace tiempo, cuando el destino cruzó nuestros caminos por primera vez. Sin embargo, fue hace un año cuando decidimos mirarnos de nuevo, abrir el corazón y darnos una verdadera oportunidad.",
    "Desde entonces, descubrimos que el amor también se construye con paciencia, complicidad, respeto y la decisión de caminar de la mano, incluso en los días más inciertos.",
    "Cada paso nos confirmó que aquella oportunidad era, en realidad, el inicio de la historia que siempre estuvo destinada para nosotros.",
    "Hoy, nuestro camino está lleno de ilusión, sueños compartidos y una hermosa claridad que ilumina cada uno de nuestros días y nos recuerda que las mejores decisiones nacen del amor.",
    "Con inmensa felicidad, queremos invitarlos a ser testigos del momento en que uniremos nuestras vidas para siempre, celebrando junto a quienes más queremos el comienzo de este nuevo capítulo.",
];
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-historia"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino"></div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="historia" class="w-full flex justify-center py-14 px-6">
    <!--
       La historia se lee de corrido dentro del arco, sin botón ni modal.
       El relleno de arriba (pt-14) deja el título "Historia" dentro de la
       cúpula, que mide media anchura del arco.
    -->
    <div
        id="arco-historia"
        class="w-full max-w-[340px] bg-vino rounded-t-full shadow-[0_14px_30px_rgba(0,0,0,0.18)] flex flex-col items-center text-center px-5 pt-14 pb-12"
    >
        <h3
            class="font-adelia text-crema text-[clamp(1.15rem,5.6vw,1.5rem)] leading-[1.4]"
        >
            {tituloArco}
        </h3>

        <div class="mt-6 space-y-4">
            {
                parrafos.map((parrafo) => (
                    <p class="font-balham font-normal text-crema text-[clamp(0.86rem,4.5vw,1.22rem)] tracking-[0.03em] leading-[1.55]">
                        {parrafo}
                    </p>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-historia");
        if (franja) animarFranja(franja);

        const arco = document.getElementById("arco-historia");
        // El arco entra como una sola pieza: es un texto largo, encadenar
        // párrafos haría esperar de más para algo que se lee de corrido.
        if (arco) animarEntrada(arco, arco, { y: 22 });
    });
</script>
