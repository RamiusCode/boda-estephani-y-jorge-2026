---
// src/components/Historia.astro
// Banda "Nuestra Historia" + llamado con botón que abre la historia en un modal.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "NUESTRA HISTORIA";

const pregunta = "¿Quieres saber cómo empezó todo?";
const invitacion = ["Toca el botón y descubre", "nuestra historia de amor"];
const textoBoton = "LEER NUESTRA HISTORIA";

const parrafos = [
    "Hay historias que comienzan en el momento menos esperado… y otras que, sin saberlo, empiezan mucho antes.",
    "La nuestra comenzó hace tiempo, cuando el destino cruzó nuestros caminos por primera vez. Sin embargo, fue hace un año cuando decidimos mirarnos de nuevo, abrir el corazón y darnos una verdadera oportunidad.",
    "Desde entonces, descubrimos que el amor también se construye con paciencia, complicidad, respeto y la decisión de caminar de la mano, incluso en los días más inciertos. Cada paso nos confirmó que aquella oportunidad era, en realidad, el inicio de la historia que siempre estuvo destinada para nosotros.",
    "Hoy, nuestro camino está lleno de ilusión, sueños compartidos y una hermosa claridad que ilumina cada uno de nuestros días y nos recuerda que las mejores decisiones nacen del amor.",
    "Con inmensa felicidad, queremos invitarlos a ser testigos del momento en que uniremos nuestras vidas para siempre, celebrando junto a quienes más queremos el comienzo de este nuevo capítulo.",
];
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-historia"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino"></div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="historia" class="w-full px-6 py-14 text-center">
    <p
        class="font-adelia text-vino text-[clamp(0.86rem,4.3vw,1.16rem)] leading-[1.6] whitespace-nowrap"
    >
        {pregunta}
    </p>

    <p
        class="font-balham text-marron text-[clamp(0.9rem,4.8vw,1.3rem)] leading-[1.6] mt-4"
    >
        {invitacion.map((linea) => <span class="block">{linea}</span>)}
    </p>

    <!-- Corazón y flecha, como en la referencia -->
    <svg
        class="w-[22px] h-[22px] mx-auto mt-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        style="color: #861622"
    >
        <path
            d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z"
        ></path>
    </svg>

    <!-- Tres flechas que se encienden en cadena señalando el botón -->
    <div class="flechas mt-2 flex flex-col items-center" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 9l6 6 6-6"></path>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 9l6 6 6-6"></path>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 9l6 6 6-6"></path>
        </svg>
    </div>

    <button
        id="abrir-historia"
        type="button"
        class="flex w-full max-w-[285px] mx-auto items-center justify-center gap-2 mt-5 px-6 py-3.5 rounded-[10px] bg-vino text-crema font-callingstone text-[clamp(0.7rem,3.1vw,0.84rem)] tracking-[0.18em] whitespace-nowrap cursor-pointer shadow-[0_4px_12px_rgba(0,0,0,0.14)] transition-transform hover:scale-[1.04]"
    >
        <svg
            class="w-[13px] h-[13px] shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
        >
            <path
                d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z"
            ></path>
        </svg>
        {textoBoton}
    </button>
</section>

<!-- ── MODAL CON LA HISTORIA ────────────────────────────────── -->
<div
    id="modal-historia"
    class="fixed inset-0 z-[9500] hidden items-center justify-center px-5 py-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-historia-titulo"
>
    <div id="modal-fondo" class="absolute inset-0 bg-black/55"></div>

    <div
        id="modal-panel"
        class="relative w-full max-w-[390px] max-h-full overflow-y-auto rounded-2xl bg-papel px-7 pt-10 pb-9 shadow-[0_20px_50px_rgba(0,0,0,0.35)]"
    >
        <button
            id="cerrar-historia"
            type="button"
            aria-label="Cerrar la historia"
            class="absolute top-3 right-3 w-9 h-9 rounded-full flex items-center justify-center text-vino cursor-pointer transition-transform hover:scale-110"
        >
            <svg
                class="w-[18px] h-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
            >
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>

        <h3
            id="modal-historia-titulo"
            class="font-callingstone text-vino text-center text-[clamp(0.8rem,3.8vw,1.05rem)] tracking-[0.16em]"
        >
            {titulo}
        </h3>

        <div class="mt-6 space-y-4">
            {
                parrafos.map((parrafo) => (
                    <p class="font-balham text-marron text-[clamp(0.92rem,4.4vw,1.18rem)] leading-[1.7] text-center">
                        {parrafo}
                    </p>
                ))
            }
        </div>
    </div>
</div>

<style>
    /*
       Tres flechas y nada más: apenas solapadas para que se lean como tres
       y no como una mancha, y cada una se enciende con un retardo distinto,
       así el ojo baja en cadena hasta el botón.
    */
    .flechas svg {
        width: 20px;
        height: 20px;
        color: #861622;
        stroke-width: 1.7;
        stroke-linecap: round;
        opacity: 0.38;
        margin-top: -5px;
        animation: bajar-flecha 1.7s ease-in-out infinite;
    }

    .flechas svg:first-child {
        margin-top: 0;
    }
    .flechas svg:nth-child(2) {
        animation-delay: 0.22s;
    }
    .flechas svg:nth-child(3) {
        animation-delay: 0.44s;
    }

    @keyframes bajar-flecha {
        0%,
        70%,
        100% {
            opacity: 0.38;
            transform: translateY(0);
        }
        35% {
            opacity: 1;
            transform: translateY(3px);
        }
    }

    /* Para quien pidió menos movimiento, quedan quietas y visibles */
    @media (prefers-reduced-motion: reduce) {
        .flechas svg {
            animation: none;
            opacity: 0.55;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-historia");
        if (franja) animarFranja(franja);

        const seccion = document.getElementById("historia");
        if (seccion) animarEntrada(seccion.children, seccion);

        const modal = document.getElementById("modal-historia");
        const panel = document.getElementById("modal-panel");
        const fondo = document.getElementById("modal-fondo");
        const abrir = document.getElementById("abrir-historia");
        const cerrar = document.getElementById("cerrar-historia");
        if (!modal || !panel || !abrir) return;

        // El scroll del fondo se bloquea mientras el modal está abierto para
        // que el dedo mueva la historia y no la invitación de atrás.
        const abrirModal = () => {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
            panel.scrollTop = 0;
            gsap.fromTo(fondo, { opacity: 0 }, { opacity: 1, duration: 0.3 });
            gsap.fromTo(
                panel,
                { opacity: 0, y: 26, scale: 0.97 },
                { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: "power2.out" },
            );
        };

        const cerrarModal = () => {
            gsap.to(panel, {
                opacity: 0,
                y: 20,
                scale: 0.98,
                duration: 0.28,
                ease: "power2.in",
            });
            gsap.to(fondo, {
                opacity: 0,
                duration: 0.28,
                onComplete: () => {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                    document.body.style.overflow = "";
                },
            });
        };

        abrir.addEventListener("click", abrirModal);
        cerrar?.addEventListener("click", cerrarModal);
        fondo?.addEventListener("click", cerrarModal);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !modal.classList.contains("hidden")) {
                cerrarModal();
            }
        });
    });
</script>
