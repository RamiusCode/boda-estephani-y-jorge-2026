---
// src/components/Cronograma.astro
// Banda "Cronograma" + línea de tiempo en zigzag con los momentos del día.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "CRONOGRAMA";

// Los iconos salen de /public/imagenes, donde cada archivo lleva el nombre
// del momento al que corresponde.
const momentos = [
    { nombre: ["CEREMONIA", "CIVIL"], hora: "13:00 P.M.", icono: "ceremoniacivil.png" },
    { nombre: ["FOTOS"], hora: "13:30 P.M.", icono: "fotos.png" },
    { nombre: ["BAILE"], hora: "14:00 P.M.", icono: "vals.png" },
    { nombre: ["BRINDIS"], hora: "14:30 P.M.", icono: "brindis.png" },
    { nombre: ["PARTY"], hora: "15:00 P.M.", icono: "party.png" },
    { nombre: ["CENA"], hora: "16:00 P.M.", icono: "cena.png" },
    { nombre: ["TORTA"], hora: "17:00 P.M.", icono: "torta.png" },
    { nombre: ["PARTY"], hora: "17:30 P.M.", icono: "party.png" },
    { nombre: ["DESPEDIDA", "NOVIOS"], hora: "21:30 P.M.", icono: "despedida.png" },
];
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-cronograma"
    class="franja relative w-full py-9 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino"></div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section class="w-full px-6 py-14">
    <div class="relative max-w-[330px] mx-auto">
        <!-- Línea central: sólida y en vino, como en el diseño -->
        <div class="absolute left-1/2 top-3 bottom-3 w-px -translate-x-1/2 bg-vino"></div>

        {
            momentos.map((momento, i) => (
                // Cada momento sube 16px (~15% de su alto) sobre el anterior:
                // como se alternan izquierda y derecha, se encabalgan sin
                // pisarse y la línea queda mucho más compacta.
                <div
                    class={`momento relative grid grid-cols-2 gap-3 ${
                        i > 0 ? "-mt-4" : ""
                    }`}
                    data-lado={i % 2 === 0 ? "der" : "izq"}
                >
                    {/*
                       Tramo horizontal que sale de la línea central hacia el
                       lado donde está el ítem, a la altura del centro del
                       icono (la mitad de sus 40px).
                    */}
                    <span
                        class={`momento-marca absolute top-[20px] h-px w-[14px] bg-vino ${
                            i % 2 === 0 ? "left-1/2" : "right-1/2"
                        }`}
                    />

                    {/* Punto sobre la línea central, en el arranque del tramo */}
                    <span class="momento-marca absolute left-1/2 top-[20px] -translate-x-1/2 -translate-y-1/2 w-[4px] h-[4px] rounded-full bg-vino" />

                    <div
                        class={`momento-contenido flex flex-col items-center text-center ${
                            i % 2 === 0 ? "col-start-2" : "col-start-1"
                        }`}
                    >
                        <span
                            class="momento-icono icono icono-marron w-[40px] h-[40px]"
                            style={`--ic: url('/imagenes/${momento.icono}')`}
                            aria-hidden="true"
                        />
                        <h3 class="font-callingstone text-vino text-[clamp(0.57rem,2.8vw,0.75rem)] tracking-[0.1em] leading-[1.7] mt-2">
                            {momento.nombre.map((linea) => (
                                <span class="momento-nombre block whitespace-nowrap">
                                    {linea}
                                </span>
                            ))}
                        </h3>
                        <p class="momento-hora font-balham text-marron text-[clamp(0.66rem,3.1vw,0.83rem)] tracking-wide mt-1">
                            {momento.hora}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    gsap.registerPlugin(ScrollTrigger);

    // Mismos valores que el helper compartido, para que el cronograma entre
    // con el mismo timing que el resto de la invitación.
    const ARRANQUE = "top 92%";
    const ACCIONES = "restart none none reset";

    const menosMovimiento = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-cronograma");
        if (franja) animarFranja(franja);

        /*
           Cada momento se dispara con su propio trigger en vez de escalonar
           los diez a la vez: la lista es larga y, con un solo trigger, los
           últimos se animarían estando todavía fuera de pantalla. Así además
           entran uno por uno, en orden, al ritmo del scroll.

           Dentro de cada momento las tres piezas entran encadenadas y cada
           una con su propio gesto, para que la línea de tiempo se arme sola
           delante del invitado en vez de aparecer de golpe:

             · el icono llega desde su lado y asienta con un rebote corto,
             · el nombre lo sigue renglón por renglón,
             · la hora cierra soltando las letras desde muy separadas.

           El encadenado va lento a propósito (~1,4s de punta a punta) para
           que se lea delicado, pero cada pieza ya es legible mucho antes:
           el invitado sigue bajando mientras mira y no espera nada.

           El punto y el tramo no se mueven: son parte de la línea, sólo
           aparecen, si no se despegarían del eje.
        */
        document.querySelectorAll<HTMLElement>(".momento").forEach((momento) => {
            const marcas =
                momento.querySelectorAll<HTMLElement>(".momento-marca");
            const icono = momento.querySelector<HTMLElement>(".momento-icono");
            const nombre =
                momento.querySelectorAll<HTMLElement>(".momento-nombre");
            const hora = momento.querySelector<HTMLElement>(".momento-hora");

            animarEntrada(marcas, momento, { y: 0, stagger: 0, duration: 0.8 });

            const piezas = [icono, ...nombre, hora].filter(
                (pieza): pieza is HTMLElement => pieza !== null,
            );
            if (piezas.length === 0) return;

            const scrollTrigger = {
                trigger: momento,
                start: ARRANQUE,
                toggleActions: ACCIONES,
            };

            // Quien pidió menos movimiento recibe el mismo orden, pero sólo
            // como aparición: nada se desplaza ni rebota.
            if (menosMovimiento()) {
                gsap.fromTo(
                    piezas,
                    { opacity: 0 },
                    {
                        opacity: 1,
                        duration: 0.45,
                        stagger: 0.08,
                        ease: "power1.out",
                        scrollTrigger,
                    },
                );
                return;
            }

            const desde = momento.dataset.lado === "der" ? 1 : -1;
            const entrada = gsap.timeline({ scrollTrigger });

            if (icono) {
                entrada.fromTo(
                    icono,
                    {
                        opacity: 0,
                        x: desde * 44,
                        scale: 0.55,
                        filter: "blur(6px)",
                    },
                    {
                        opacity: 1,
                        x: 0,
                        scale: 1,
                        filter: "blur(0px)",
                        duration: 1,
                        // Un rebote apenas insinuado: el icono llega y se
                        // asienta sin rebotar de golpe.
                        ease: "back.out(1.05)",
                    },
                    0,
                );
            }

            if (nombre.length > 0) {
                entrada.fromTo(
                    nombre,
                    { opacity: 0, x: desde * 24, filter: "blur(4px)" },
                    {
                        opacity: 1,
                        x: 0,
                        filter: "blur(0px)",
                        duration: 0.85,
                        stagger: 0.14,
                        ease: "sine.out",
                    },
                    0.24,
                );
            }

            if (hora) {
                // Las letras arrancan muy abiertas y se cierran hasta su
                // interletrado real: el remate elegante de cada momento.
                entrada.fromTo(
                    hora,
                    {
                        opacity: 0,
                        y: 6,
                        letterSpacing: "0.3em",
                        filter: "blur(5px)",
                    },
                    {
                        opacity: 1,
                        y: 0,
                        letterSpacing: "0.025em",
                        filter: "blur(0px)",
                        duration: 0.95,
                        ease: "sine.out",
                        // El interletrado queda fijado inline por el tween;
                        // se limpia para que mande de nuevo la clase.
                        clearProps: "letterSpacing",
                    },
                    0.5,
                );
            }
        });
    });
</script>
