---
// src/components/Portada.astro - Portada en dos pasos:
//   1. arco vino con los nombres + botón de ingreso (arranca la música)
//   2. el sobre: se toca para abrir la invitación
// ── DATOS EDITABLES ───────────────────────────────────────────
const anuncio = "¡ NOS CASAMOS !";
const monograma = "SJ";
// Los nombres van separados porque el "&" lleva su propia fuente: en Adelia
// el ampersand se confunde con las letras de al lado y no se lee.
const novia = "Stephanie";
const novio = "Jorge";
const invitado = "Señor: Sebastian Rocabado";
const textoBoton = "Ingresar a la Invitación";
const textoSobre = "Toca el sobre para abrir la invitación";
// ──────────────────────────────────────────────────────────────
---

<!-- CAPA BLANCA DE TRANSICIÓN — tapa el fondo del layout durante el fade -->
<div
    id="capa-blanca"
    style="
    position: fixed;
    inset: 0;
    background: #ffffff;
    z-index: 8499;
    opacity: 1;
    pointer-events: none;
"
>
</div>

<!--
   La portada va por debajo del botón flotante de música (z 9000): en la
   pantalla del sobre la melodía ya suena y el invitado tiene que poder
   pausarla sin haber entrado todavía a la invitación.
-->
<section
    class="fixed inset-0 w-full h-screen flex justify-center z-[8500]"
    id="portada-section"
    style="background-color: #e9e4dd;"
>
    <!-- Columna móvil: el diseño nunca se estira en tablet / PC -->
    <div
        class="relative w-full max-w-[430px] h-full flex flex-col items-center justify-center px-6"
        style="background-color: #f7f5f2; background-image: url('/imagenes/fondoprincipal.png'); background-size: cover; background-position: center; background-repeat: no-repeat; box-shadow: 0 0 40px rgba(0,0,0,0.08);"
    >
        <!-- Arco vino con el anuncio, el monograma y los nombres -->
        <div
            id="arco-portada"
            class="relative w-full max-w-[380px] bg-vino rounded-t-full shadow-[0_14px_30px_rgba(0,0,0,0.18)] flex flex-col items-center text-center px-5 pt-32 pb-9"
        >
            <!--
               Anuncio curvado siguiendo la cúpula del arco.
               La curva está medida sobre cambio.pdf: es un círculo centrado en
               el eje del arco, con el centro a 0.745 del ancho por debajo del
               borde superior y radio de línea base 0.472 del ancho. El viewBox
               usa como unidad el ancho máximo del arco (380), así que el texto
               escala solo cuando la columna es más angosta.
            -->
            <svg
                id="anuncio-curvo"
                class="absolute left-0 top-0 w-full pointer-events-none"
                viewBox="0 0 380 150"
                aria-hidden="true"
            >
                <path
                    id="curva-anuncio"
                    d="M 10.5 283 A 179.5 179.5 0 0 1 369.5 283"
                    fill="none"
                ></path>
                <text
                    class="font-callingstone"
                    fill="#f7f5f6"
                    font-size="21.6"
                    letter-spacing="3.89"
                    text-anchor="middle"
                >
                    <textPath href="#curva-anuncio" startOffset="50%"
                        >{anuncio}</textPath
                    >
                </text>
            </svg>

            <!--
               Monograma como imagen. El ancho y el margen salen de medir el SJ
               en cambio.pdf: 0.19 del ancho del arco (72px sobre 380) y el
               borde superior a 168px del borde superior del arco.
            -->
            <img
                src="/imagenes/sj.png"
                alt={monograma}
                width="908"
                height="702"
                class="w-[72px] h-auto mt-10"
            />

            <h1
                class="font-adelia text-crema text-[clamp(1.5rem,7vw,1.9rem)] leading-[1.35] mt-[42.5px] whitespace-nowrap"
            >
                {novia}<span
                    class="font-crimson italic text-[1.25em] mx-[0.16em] align-[-0.02em]"
                    >&amp;</span
                >{novio}
            </h1>

            <p
                class="font-callingstone text-crema/95 text-[clamp(0.85rem,4vw,1.05rem)] tracking-wide mt-14"
            >
                {invitado}
            </p>
        </div>

        <!-- Botón de ingreso -->
        <button
            id="btn-ingresar"
            type="button"
            class="mt-10 px-9 py-3 rounded-xl bg-vino text-crema font-callingstone text-[clamp(0.9rem,4vw,1.15rem)] tracking-[0.12em] whitespace-nowrap cursor-pointer shadow-[0_8px_18px_rgba(0,0,0,0.18)]"
        >
            {textoBoton}
        </button>

        <!--
           PANTALLA 2 — El sobre. Va encima de la primera, centrada en la
           misma columna, y recién se muestra cuando la primera termina de
           salir. Arranca oculta para que no tape el botón de ingreso.
        -->
        <div
            id="pantalla-sobre"
            class="absolute inset-0 flex flex-col items-center justify-center px-6 opacity-0 pointer-events-none"
        >
            <!-- BLOQUE ARCO + SOBRE (compensa el arco que sobresale a la izquierda) -->
            <div class="bloque-sobre">
                <div
                    id="sobre-container"
                    class="relative w-full cursor-pointer select-none"
                >
                    <!-- Arco vino (detrás) -->
                    <div id="arco-sobre" class="arco-vino"></div>

                    <!-- Sobre -->
                    <img
                        id="sobre-img"
                        src="/imagenes/sobre.png"
                        alt="Sobre de invitación"
                        width="370"
                        height="545"
                        class="relative block w-full h-auto z-[2]"
                    />
                </div>
            </div>

            <!-- Instrucción -->
            <p id="instruccion" class="instruccion font-balham">
                {textoSobre}
            </p>
        </div>
    </div>
</section>

<style>
    /*
       El arco sobresale 14% hacia la izquierda del sobre, así que el bloque
       se desplaza la mitad de ese excedente (7%) para que el conjunto
       arco + sobre quede ópticamente centrado en la columna.
    */
    .bloque-sobre {
        width: 100%;
        max-width: 270px;
        transform: translateX(7%);
    }

    /* Arco vino: rectángulo con la parte superior semicircular */
    .arco-vino {
        position: absolute;
        top: -25%;
        bottom: 15%;
        left: -14%;
        width: 106%;
        background-color: var(--color-vino);
        border-radius: 9999px 9999px 0 0;
        z-index: 1;
    }

    /* Sombra suave del sobre sobre el arco */
    #sobre-img {
        filter: drop-shadow(0 14px 26px rgba(0, 0, 0, 0.22));
    }

    /*
       El pie va en un solo renglón como en el PDF: con el cuerpo de antes
       (0.78rem) la frase partía en dos líneas dentro de la columna de 430px.
    */
    .instruccion {
        margin-top: 2.5rem;
        text-align: center;
        color: var(--color-marron);
        font-size: clamp(0.6rem, 2.6vw, 0.75rem);
        letter-spacing: 0.18em;
        line-height: 1.9;
        text-transform: uppercase;
    }

    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    /* La capa blanca tapa el fondo del layout siempre */
    #capa-blanca {
        transition: opacity 0.4s ease;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            const arco = document.getElementById("arco-portada");
            const boton = document.getElementById("btn-ingresar");
            if (!arco || !boton) return;

            // ── Estado inicial ──────────────────────────────────────
            gsap.set(arco, {
                scaleY: 0,
                transformOrigin: "bottom center",
                opacity: 0,
            });
            gsap.set(arco.children, { opacity: 0, y: 20 });
            gsap.set(boton, { opacity: 0, y: 14 });

            // ── Animaciones de entrada ──────────────────────────────
            const tl = gsap.timeline({ delay: 0.3 });

            tl.to(arco, {
                scaleY: 1,
                opacity: 1,
                duration: 1.1,
                ease: "power3.out",
            })
                // El texto entra recién con el arco ya crecido: si no,
                // se dibuja aplastado por el scaleY del padre.
                .to(
                    arco.children,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        stagger: 0.14,
                        ease: "power2.out",
                    },
                    1.05,
                )
                .to(
                    boton,
                    { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
                    1.85,
                );

            // ── Latido sutil del botón (invita a tocarlo) ───────────
            tl.add(() => {
                gsap.to(boton, {
                    y: -6,
                    duration: 2.4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            });

            // ── Hover ───────────────────────────────────────────────
            // El escalado va por GSAP y no con hover:scale de Tailwind:
            // el latido de arriba escribe transform inline y le ganaría.
            boton.addEventListener("mouseenter", () => {
                gsap.to(boton, { scale: 1.04, duration: 0.3, ease: "power2.out" });
            });
            boton.addEventListener("mouseleave", () => {
                gsap.to(boton, { scale: 1, duration: 0.3, ease: "power2.out" });
            });

            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");
            const pantallaSobre = document.getElementById("pantalla-sobre");
            const sobreContainer = document.getElementById("sobre-container");

            // ── Pantalla 2: el sobre ────────────────────────────────
            // Entra igual que el arco de arriba: crece desde abajo y el
            // sobre aparece recién cuando el arco ya terminó de crecer.
            const mostrarSobre = () => {
                if (!pantallaSobre) return;

                // La primera pantalla queda invisible pero sigue en el DOM:
                // sin esto se comería los clicks del sobre.
                gsap.set([arco, boton], { pointerEvents: "none" });

                pantallaSobre.classList.remove("pointer-events-none");
                gsap.set(pantallaSobre, { opacity: 1 });
                gsap.set("#arco-sobre", {
                    scaleY: 0,
                    transformOrigin: "bottom center",
                    opacity: 0,
                });
                gsap.set("#sobre-img", { opacity: 0, y: 40, scale: 0.94 });
                gsap.set("#instruccion", { opacity: 0, y: 12 });

                gsap.timeline()
                    .to("#arco-sobre", {
                        scaleY: 1,
                        opacity: 1,
                        duration: 0.9,
                        ease: "power3.out",
                    })
                    .to(
                        "#sobre-img",
                        {
                            opacity: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.9,
                            ease: "power2.out",
                        },
                        0.35,
                    )
                    .to(
                        "#instruccion",
                        { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" },
                        0.8,
                    )
                    // Latido sutil del sobre (invita a tocarlo)
                    .add(() => {
                        gsap.to("#sobre-img", {
                            y: -8,
                            duration: 2.4,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    });
            };

            // ── Click en el botón: arranca la música y trae el sobre ──
            boton.addEventListener("click", () => {
                gsap.killTweensOf(boton);

                // La melodía ya suena en la pantalla del sobre; el botón
                // flotante de BotonMusica.astro aparece solo al detectarla.
                const audio = new Audio("/musica/melodia2.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch((error) => {
                    console.log("❌ Error al reproducir audio:", error);
                });
                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;

                gsap.timeline({ onComplete: mostrarSobre })
                    .to(boton, {
                        y: 0,
                        scale: 1.06,
                        duration: 0.25,
                        ease: "power2.in",
                    })
                    .to(
                        boton,
                        { opacity: 0, duration: 0.35, ease: "power2.in" },
                        0.3,
                    )
                    .to(
                        arco.children,
                        {
                            opacity: 0,
                            y: -10,
                            duration: 0.35,
                            stagger: 0.05,
                            ease: "power2.in",
                        },
                        0.25,
                    )
                    .to(
                        arco,
                        {
                            scaleY: 0,
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                        },
                        0.55,
                    );
            });

            // ── Hover del sobre ─────────────────────────────────────
            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to(sobreContainer, {
                    scale: 1.04,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });
            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to(sobreContainer, {
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // ── Click en el sobre: se abre la invitación ─────────────
            sobreContainer?.addEventListener("click", () => {
                gsap.killTweensOf("#sobre-img");

                gsap.timeline()
                    .to("#sobre-img", {
                        y: 0,
                        scale: 1.08,
                        duration: 0.25,
                        ease: "power2.in",
                    })
                    .to(
                        "#instruccion",
                        {
                            opacity: 0,
                            y: -10,
                            duration: 0.35,
                            ease: "power2.in",
                        },
                        0.1,
                    )
                    .to(
                        "#sobre-img",
                        {
                            opacity: 0,
                            scale: 1.35,
                            duration: 0.45,
                            ease: "power2.in",
                        },
                        0.3,
                    )
                    .to(
                        "#arco-sobre",
                        {
                            scaleY: 0,
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                        },
                        0.35,
                    )
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove(
                                    "portada-activa",
                                );
                                document.body.style.overflow = "auto";
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                // Desvanecer la capa blanca suavemente
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                                window.scrollTo({ top: 0, behavior: "smooth" });
                            },
                        },
                        0.6,
                    );
            });
        });
    }
</script>
