---
// src/components/NombresFlores.astro
// Arco vino con el anuncio, el monograma y los nombres de los novios.
// ── DATOS EDITABLES ───────────────────────────────────────────
const anuncio = "¡ Nos Casamos !";
const monograma = "SJ";
const novios = "Stephanie & Jorge";
const invitado = "Señor: Sebastian Rocabado";
// ──────────────────────────────────────────────────────────────
---

<section class="w-full flex justify-center pt-8 pb-10 px-5">
    <div
        id="arco-novios"
        class="w-full max-w-[380px] bg-vino rounded-t-full shadow-[0_14px_30px_rgba(0,0,0,0.18)] flex flex-col items-center text-center px-5 pt-28 pb-9"
    >
        <p
            class="font-callingstone text-crema text-[1.35rem] tracking-[0.18em] leading-none"
        >
            {anuncio}
        </p>

        <p
            class="font-tangerine text-crema text-[4.6rem] leading-[1.1] mt-6"
            id="monograma-novios"
        >
            {monograma}
        </p>

        <h1
            class="font-adelia text-crema text-[clamp(1.5rem,7vw,1.9rem)] leading-[1.35] mt-1 whitespace-nowrap"
        >
            {novios}
        </h1>

        <p
            class="font-balham text-crema/95 text-[clamp(0.85rem,4vw,1.05rem)] tracking-wide mt-10"
        >
            {invitado}
        </p>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const arco = document.getElementById("arco-novios");
        if (!arco) return;

        gsap.from(arco.children, {
            scrollTrigger: { trigger: arco, start: "top 85%" },
            opacity: 0,
            y: 26,
            duration: 0.9,
            stagger: 0.14,
            ease: "power2.out",
        });
    });
</script>
