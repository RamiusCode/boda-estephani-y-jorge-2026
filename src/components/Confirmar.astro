---
// src/components/Confirmar.astro
// Banda "Querida familia y amigos" + pases reservados + confirmación por WhatsApp.

// Cantidad de pases del invitado. Se pasa desde index.astro:
//     <Confirmar pases={2} />
// Así cada invitado puede tener su propia invitación con su número de pases.
interface Props {
    pases?: number;
}

const { pases = 1 } = Astro.props;

const enLetras = [
    "",
    "un",
    "dos",
    "tres",
    "cuatro",
    "cinco",
    "seis",
    "siete",
    "ocho",
];
const pasesEnLetras = enLetras[pases] ?? String(pases);

const etiquetaPases =
    pases === 1 ? "PASE PARA 1 PERSONA" : `PASE PARA ${pases} PERSONAS`;

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "QUERIDA FAMILIA Y AMIGOS";

// Renglones cortos a propósito: con líneas largas el texto no podía crecer
// sin desbordar los 398px de ancho útil.
const parrafos = [
    [
        "Nos llena de felicidad poder",
        "compartir con ustedes este",
        "momento tan especial.",
    ],
    [
        "Con la esperanza de que hagamos",
        "de este día un recuerdo",
        "inolvidable.",
    ],
    [
        "Los esperamos con los corazones",
        "llenos de emoción, listos para",
        "celebrar con amor y crear",
        "memorias que permanezcan por siempre",
        
    ],
];

const despedida = "TE ESPERAMOS";

// WhatsApp de los novios (código de país + número, sin + ni espacios).
const whatsapp = "59161006490";
// El mensaje solo cambia de singular a plural según los pases; no menciona
// la cantidad de personas ni la hora.
const mensaje =
    pases === 1
        ? "Me complace confirmar mi asistencia a la boda de Stephanie y Jorge. Nos vemos el sábado 29 de agosto. ¡Estaré sin falta!"
        : "Nos complace confirmar nuestra asistencia a la boda de Stephanie y Jorge. Nos vemos el sábado 29 de agosto. ¡Allí estaremos!";

const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;

const textoBoton = "CONFIRMAR ASISTENCIA";
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-confirmar"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino"></div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="confirmar" class="w-full px-4 py-14 text-center">
    <div class="space-y-4">
        {
            parrafos.map((parrafo) => (
                <p class="font-balham text-marron text-[clamp(0.9rem,4.8vw,1.3rem)] leading-[1.5]">
                    {parrafo.map((linea) => (
                        <span class="block whitespace-nowrap">{linea}</span>
                    ))}
                </p>
            ))
        }
    </div>

    <a
        href={enlace}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full max-w-[285px] mx-auto mt-7 px-6 py-3.5 rounded-[10px] bg-marron text-crema font-callingstone text-[clamp(0.7rem,3.1vw,0.84rem)] tracking-[0.18em] whitespace-nowrap shadow-[0_4px_12px_rgba(0,0,0,0.14)] transition-transform hover:scale-[1.04]"
    >
        {textoBoton}
    </a>

    <!-- Pases reservados para este invitado -->
    <p
        class="inline-block mt-4 px-4 py-2.5 rounded-md bg-marron text-crema font-callingstone text-[clamp(0.5rem,2.3vw,0.62rem)] tracking-[0.12em] whitespace-nowrap"
    >
        {etiquetaPases}
    </p>

    <p
        class="font-balham text-marron text-[clamp(0.9rem,4.8vw,1.3rem)] leading-[1.5] mt-12"
    >
        {despedida}
    </p>
</section>

<script>
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-confirmar");
        if (franja) animarFranja(franja);

        const seccion = document.getElementById("confirmar");
        if (seccion) animarEntrada(seccion.children, seccion);
    });
</script>
