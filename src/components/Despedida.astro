---
// src/components/Despedida.astro
// Arco final a todo el ancho con el monograma, los nombres y la fecha.
// ── DATOS EDITABLES ───────────────────────────────────────────
const monograma = "SJ";
const novios = "Stephanie & Jorge";
const fecha = "29 de Agosto del 2026";
// ──────────────────────────────────────────────────────────────
---

<section class="w-full pt-6">
    <div
        id="arco-final"
        class="w-full bg-vino rounded-t-full px-6 pt-[34%] pb-20 text-center"
    >
        <p class="font-tangerine text-crema text-[4.2rem] leading-none">
            {monograma}
        </p>

        <h2 class="font-adelia text-crema text-[2.1rem] leading-[1.4] mt-3">
            {novios}
        </h2>

        <p
            class="font-callingstone text-crema text-[1.2rem] tracking-[0.14em] mt-8"
        >
            {fecha}
        </p>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const arco = document.getElementById("arco-final");
        if (!arco) return;

        gsap.from(arco.children, {
            scrollTrigger: { trigger: arco, start: "top 80%" },
            opacity: 0,
            y: 26,
            duration: 0.9,
            stagger: 0.16,
            ease: "power2.out",
        });
    });
</script>
