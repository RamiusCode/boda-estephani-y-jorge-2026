---
// src/components/Portada.astro - Portada minimalista: arco guindo + sobre
---

<!-- CAPA BLANCA DE TRANSICIÓN — tapa el fondo del layout durante el fade -->
<div
    id="capa-blanca"
    style="
    position: fixed;
    inset: 0;
    background: #ffffff;
    z-index: 9999;
    opacity: 1;
    pointer-events: none;
"
>
</div>

<section
    class="fixed inset-0 w-full h-screen flex justify-center z-[10000]"
    id="portada-section"
    style="background-color: #f7f5f2; background-image: url('/imagenes/fondoprincipal.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"
>
    <div
        class="relative w-full max-w-[480px] h-full flex flex-col items-center justify-center px-6"
    >
        <!-- BLOQUE ARCO + SOBRE -->
        <div id="sobre-container" class="relative cursor-pointer select-none">
            <!-- Arco guindo (detrás) -->
            <div id="arco" class="arco-guindo"></div>

            <!-- Sobre -->
            <img
                id="sobre-img"
                src="/imagenes/sobre.png"
                alt="Sobre de invitación"
                class="relative block w-[clamp(200px,58vw,260px)] h-auto z-[2]"
            />
        </div>

        <!-- Instrucción -->
        <p id="instruccion" class="instruccion font-balham">
            Toca el sobre para abrir la invitación
        </p>
    </div>
</section>

<style>
    /* Arco guindo: rectángulo con la parte superior semicircular */
    .arco-guindo {
        position: absolute;
        top: -21%;
        bottom: 15%;
        left: -14%;
        width: 106%;
        background-color: #a4142b;
        border-radius: 9999px 9999px 0 0;
        z-index: 1;
    }

    /* Sombra suave del sobre sobre el arco */
    #sobre-img {
        filter: drop-shadow(0 14px 26px rgba(0, 0, 0, 0.22));
    }

    .instruccion {
        margin-top: 3.2rem;
        text-align: center;
        color: #4f4a47;
        font-size: clamp(0.68rem, 2.6vw, 0.82rem);
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    /* La capa blanca tapa el fondo del layout siempre */
    #capa-blanca {
        transition: opacity 0.4s ease;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            // ── Estado inicial ──────────────────────────────────────
            gsap.set("#arco", {
                scaleY: 0,
                transformOrigin: "bottom center",
                opacity: 0,
            });
            gsap.set("#sobre-img", { opacity: 0, y: 40, scale: 0.94 });
            gsap.set("#instruccion", { opacity: 0, y: 12 });

            // ── Animaciones de entrada ──────────────────────────────
            const tl = gsap.timeline({ delay: 0.3 });

            tl.to("#arco", {
                scaleY: 1,
                opacity: 1,
                duration: 1.1,
                ease: "power3.out",
            })
                .to(
                    "#sobre-img",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power2.out",
                    },
                    0.5,
                )
                .to(
                    "#instruccion",
                    { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
                    1.1,
                );

            // ── Latido sutil del sobre (invita a tocarlo) ───────────
            tl.add(() => {
                gsap.to("#sobre-img", {
                    y: -8,
                    duration: 2.4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            });

            // ── Hover ───────────────────────────────────────────────
            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-container", {
                    scale: 1.04,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });
            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-container", {
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // ── Click en el sobre ───────────────────────────────────
            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");

            sobreContainer?.addEventListener("click", () => {
                gsap.killTweensOf("#sobre-img");

                // Música
                const audio = new Audio("/musica/melodia2.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch((error) => {
                    console.log("❌ Error al reproducir audio:", error);
                });
                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-img", {
                        y: 0,
                        scale: 1.08,
                        duration: 0.25,
                        ease: "power2.in",
                    })
                    .to(
                        "#instruccion",
                        { opacity: 0, y: -10, duration: 0.35, ease: "power2.in" },
                        0.1,
                    )
                    .to(
                        "#sobre-img",
                        {
                            opacity: 0,
                            scale: 1.35,
                            duration: 0.45,
                            ease: "power2.in",
                        },
                        0.3,
                    )
                    .to(
                        "#arco",
                        {
                            scaleY: 0,
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                        },
                        0.35,
                    )
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove(
                                    "portada-activa",
                                );
                                document.body.style.overflow = "auto";
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                // Desvanecer la capa blanca suavemente
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                                window.scrollTo({ top: 0, behavior: "smooth" });
                            },
                        },
                        0.6,
                    );
            });
        });
    }
</script>
